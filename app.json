{
  "expo": {
    "name": "StandardTune",
    "slug": "standardtune-guitar",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "standardtune",
    "plugins": [
      "expo-router",
      [
        "react-native-tuner-engine",
        {
          "microphonePermission": "StandardTune uses the microphone to detect your instrument’s pitch while tuning."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.standardtune.guitar"
    },
    "android": {
      "package": "com.standardtune.guitar",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
